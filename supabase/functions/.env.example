# =====================================================================
# Edge Functions (api / admin / worker) の環境変数 — 見本
#
#   ローカル: このファイルを .env.local にコピーして値を入れ、
#             supabase functions serve --env-file supabase/functions/.env.local
#   本番    : supabase secrets set --env-file <本番用ファイル>   (値はリポジトリに入れない)
#
#   SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY は Supabase が自動で渡すので書かない。
# =====================================================================

# 公開サイトの URL (末尾は /)。メール内のリンク (照会URL・会員ページ・管理画面) に使う
SITE_URL=https://example.github.io/sky-rent/

# CORS で許可する Origin (カンマ区切り。スキーム + ホスト + ポート、末尾の / なし)
#   ここに無い Origin からのブラウザのリクエストは 403 で断る。未設定なら全て許可 (*) になるので本番では必ず設定する
ALLOWED_ORIGINS=https://example.github.io

# ゲスト照会キーの HMAC 秘密鍵 (32文字以上のランダムな文字列)
#   照会キー = base64url(HMAC-SHA256(この値, 'guest:' + 予約番号))。DB にはその sha256 だけを保存する。
#   変更すると、それまでに送った照会URLはすべて使えなくなる。
#   作り方の例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_TOKEN_SECRET=

# レート制限のキー (IP アドレス・メールアドレス) を HMAC するときの秘密 (任意・32文字以上推奨)
#   未設定なら GUEST_TOKEN_SECRET を使う
IP_HASH_SALT=

# 利用者の IP を取るヘッダ (本番では設定を推奨)。IP 単位のレート制限 (予約・問い合わせの連投防止など) に使う
#   未設定: x-forwarded-for を右端から見て最初の公開アドレスを使う (本番では起動後の最初の呼び出しで警告をログに出す)。
#     cf-connecting-ip・x-real-ip・x-forwarded-for の左側は、手前の中継が上書きしない限り利用者が自由に書けるので使わない。
#     (以前は cf-connecting-ip を無条件に使っていたが、毎回値を変えて制限を回避できたため既定から外した)
#   設定時: そのヘッダだけを使う (カンマ区切りの値なら右端から見て最初の公開アドレス)。例: cf-connecting-ip / x-real-ip
#     下の 4. で「利用者が書き換えられない」と確かめたヘッダだけを設定する。
#   利用者の IP を特定できない (社内網・ループバックのアドレスしか無い・IP でない値) とき:
#     ローカル開発 (SITE_URL が localhost / 127.0.0.1) では数えない。
#     本番では「特定できない」共有の枠で、通常の 10 倍の上限まで数える (内部アドレスを名乗って制限を外すことはできない)。
#     本番で CLIENT_IP_UNIDENTIFIED の警告がログに出る場合は、中継の設定か CLIENT_IP_HEADER を見直す。
#
#   ※ Supabase 本番の Edge Functions で、利用者の IP がどのヘッダに入るか (cf-connecting-ip が中継側で
#     上書きされるか、x-forwarded-for の右端が利用者か中継サーバーか) は、ここでは確定していない。
#     本番で1度ログを見て確認し、必要なら CLIENT_IP_HEADER を設定する:
#       1. CLIENT_IP_DEBUG=1 を設定し、自分の端末で公開サイトの予約画面を開く (空き状況の取得で記録される)
#       2. ダッシュボードの Edge Functions → api → Logs に出る "client-ip" の行を見る。
#          IP は先頭2つの数字だけ出る。自分の IP (例: https://ifconfig.me で確認) と見比べる
#       3. headers の中で自分の IP が入っているヘッダを探し、その名前をここに設定する
#          (cf-connecting-ip に入っていれば CLIENT_IP_HEADER=cf-connecting-ip)。
#          未設定のまま (x-forwarded-for の右端) で picked が自分の IP になる場合も、4. を確かめたうえで明示を推奨
#       4. 偽装できないことも確かめる: 見本のアドレスを付けて呼び、ログの picked が 203.0.*.* にならないこと
#            curl -H "apikey: <anon key>" -H "cf-connecting-ip: 203.0.113.9" -H "x-real-ip: 203.0.113.9" \
#                 -H "x-forwarded-for: 203.0.113.9" "https://<project>.supabase.co/functions/v1/api/availability?from=<ISO>&to=<ISO>"
#          203.0.*.* になる場合は、そのヘッダは利用者が書き換えられる。自分の IP が正しく入る別のヘッダを設定する
#       5. 確認が済んだら CLIENT_IP_DEBUG を消す
CLIENT_IP_HEADER=
# 上の確認用 (任意)。1 にすると IP 単位の制限のたびに、候補のヘッダと採用した IP (先頭2つだけ) をログに出す。普段は空
CLIENT_IP_DEBUG=

# worker を起動するための共有秘密 (32文字以上)。定期実行から x-worker-secret ヘッダで送る
#   service_role キーの Bearer でも起動できる
WORKER_SECRET=

# メール送信 (Resend)。RESEND_API_KEY が空ならメールは送らず、送信キューに skipped と記録する
RESEND_API_KEY=
# 既定 https://api.resend.com (テストでモックに差し替えるときだけ設定)
RESEND_API_BASE=
# 送信元。Resend で認証済みのドメインのアドレスにする
MAIL_FROM=グロースレンタカー <noreply@example.com>
# 店舗宛て通知 (新規予約・キャンセル・お問い合わせ) の宛先。カンマ区切りで複数可
SHOP_NOTIFY_EMAIL=shop@example.com

# Google カレンダー連携 (サービスアカウント鍵の JSON をそのまま、または base64 にしたもの)
#   担当者は自分のカレンダーを、鍵の client_email に「予定の変更」権限で共有する
GOOGLE_SERVICE_ACCOUNT_JSON=
# 既定 https://www.googleapis.com / 鍵の token_uri (テストでモックに差し替えるときだけ設定)
GOOGLE_API_BASE=
GOOGLE_TOKEN_URL=
